{
  "manifest_version": 3,
  "name": "Azure Boards Modernizer",
  "description": "A local-first, shadcn-inspired visual refresh for Azure Boards.",
  "version": "0.1.2",
  "permissions": ["storage"],
  "host_permissions": ["https://dev.azure.com/*"],
  "action": {
    "default_title": "Azure Boards Modernizer",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://dev.azure.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
